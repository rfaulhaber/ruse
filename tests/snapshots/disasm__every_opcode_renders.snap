0054  RAISE       r0, 0
0055  LOADK       r0, k3                ; #\λ
0056  LOADK       r0, k4                ; 9223372036854775807
0057  LOADK       r0, k5                ; #<pair>
0058  LOADK       r0, k6                ; #t
