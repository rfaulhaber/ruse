0016  EQ          r0, r1, 0             ; skip if (eq? r0 r1)
0017  EQV         r0, r1, 1             ; skip unless (eqv? r0 r1)
0018  TEST        r0, 1                 ; skip unless r0
0019  JMP         +2                    ; -> 0022
