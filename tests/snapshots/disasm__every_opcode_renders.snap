0027  CADR        r1, r0, 6
0028  TYPEP       r0, 3                 ; skip unless type 3
0029  CALL        r0, 0, 0              ; varargs, all results
0030  CALL        r0, 3, 2              ; 2 args, 1 result
0031  TAILCALL    r0, 1                 ; 0 args
0032  RETURN      r0, 0                 ; all values from r0
0033  RETURN      r0, 1                 ; no values
0034  RETURN      r0, 3                 ; 2 values
0035  RETURN1     r0
0036  APPLY       r0, 3                 ; 2 args, last spread
0037  CLOSURE     r0, p0                ; kid
0038  GETUPVAL    r0, u1
0039  SETUPVAL    r0, u1                ; u1 := r0
0040  GETGLOBAL   r0, k2                ; foo
0041  SETGLOBAL   r0, k2                ; foo
0042  GETLOCALN   r1, r0
0043  CLOSEUPVALS r1
